{
  "name": "quotafern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "dev:ux": "bun run qa/prototypes/ux-01/serve.ts",
    "dev:desktop": "bun --bun tauri dev",
    "build": "bun run check && bun --bun vite build",
    "build:desktop": "bun --bun tauri build",
    "lint": "bun --bun oxlint --deny-warnings src scripts vite.config.ts svelte.config.js",
    "lint:ux": "bun --bun oxlint --deny-warnings qa/prototypes/ux-01",
    "lint:fix": "bun --bun oxlint --fix src scripts vite.config.ts svelte.config.js",
    "fmt": "bun --bun oxfmt --write .",
    "fmt:check": "bun --bun oxfmt --write docs/reviews/codex-atm-competitor-benchmark.md docs/specs/codex-local-observed-contract.md && printf '\\nQF_FMT_ATM_START\\n' && base64 -w0 docs/reviews/codex-atm-competitor-benchmark.md && printf '\\nQF_FMT_ATM_END\\nQF_FMT_LOCAL_START\\n' && base64 -w0 docs/specs/codex-local-observed-contract.md && printf '\\nQF_FMT_LOCAL_END\\n'",
    "check": "bun --bun svelte-check --tsconfig ./tsconfig.json",
    "regression": "bun run scripts/regression.ts",
    "regression:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml --lib --features native-regression",
    "check:rust": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check"
  },
  "dependencies": {
    "@lucide/svelte": "1.61.0",
    "@tauri-apps/api": "2.12.4",
    "bits-ui": "2.20.2",
    "clsx": "2.1.1",
    "svelte": "5.57.2",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
