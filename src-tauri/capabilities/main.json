{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Restrict native commands to the sole main window.",
  "windows": ["main"],
  "permissions": [
    "allow-hide-popup",
    "allow-codex-connect",
    "allow-codex-refresh",
    "allow-codex-disconnect",
    "allow-codex-status"
  ]
}
